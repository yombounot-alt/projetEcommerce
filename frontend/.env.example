# URL de base de l'API backend. En développement, laissez /api pour un proxy local
# ou pointez directement vers votre backend (ex: http://localhost:4000/api).
VITE_API_URL=/api

# URL publique du frontend, utilisée pour générer les balises canoniques et Open Graph.
VITE_APP_URL=http://localhost:5173

# Active les services mock (aucun backend requis) tant que l'API réelle n'est pas branchée.
# Passez à "false" dès qu'un backend réel est disponible sur VITE_API_URL.
VITE_USE_MOCKS=true

# Ne jamais committer de secrets réels dans ce fichier ou ses variantes .env.*.
# Les clés publiques de services tiers (ex: clé publishable Stripe) peuvent être ici ;
# les clés secrètes n'ont jamais leur place côté frontend.
