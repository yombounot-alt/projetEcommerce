# === App ===
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# === MongoDB ===
MONGODB_URI=mongodb://127.0.0.1:27017/lumera
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/lumera_test

# === JWT ===
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# === Cookies ===
COOKIE_SECRET=change_me_cookie_secret_min_32_chars_long

# === Paiement ChapchaPay (voir src/integrations/payment/providers/chapchapay.provider.ts) ===
# Base URL de l'API ChapchaPay (sandbox et production utilisent la même à ce jour selon leur doc).
CHAPCHAPAY_BASE_URL=https://chapchappay.com/api
# Clé "CCP-Api-Key" (64 caractères hex) — clé de test ou de production, générée depuis le dashboard marchand.
CHAPCHAPAY_API_KEY=
# Clé secrète utilisée pour calculer/vérifier la signature HMAC-SHA256 ("CCP-HMAC-Signature").
CHAPCHAPAY_HMAC_SECRET=
# URL publique de CE backend, utilisée pour construire le notify_url du webhook envoyé à ChapchaPay.
# En local, utilisez un tunnel (ex: ngrok) pour que ChapchaPay puisse atteindre votre machine.
BACKEND_PUBLIC_URL=http://localhost:5000
# Filet de sécurité : délai (minutes) au-delà duquel un paiement gateway resté "pending"
# sans webhook est considéré expiré (stock relâché, commande annulée). Ne s'applique pas
# aux méthodes manuelles (cash_on_delivery/bank_transfer).
# TEMPORAIRE : mis à 24h (au lieu de ~60 min normalement souhaitable) tant que la fiabilité
# des webhooks ChapchaPay n'est pas confirmée — un vrai paiement réussi a été annulé à tort
# par ce filet le 12/09/2026 faute de webhook reçu. Redescendre vers 30-60 min dès que la
# livraison des webhooks est confirmée fiable (support ChapchaPay / staging HTTPS).
PAYMENT_PENDING_TIMEOUT_MINUTES=1440

# === SMS (générique — voir src/integrations/sms) ===
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Lumera

# === Email (générique — voir src/integrations/email) ===
# RESEND_API_KEY prioritaire sur SMTP dès qu'elle est renseignée : envoie en HTTPS (443),
# donc fonctionne même sur un hébergeur qui bloque le SMTP sortant (confirmé sur Railway).
# Clé obtenue sur https://resend.com (offre gratuite, aucune carte bancaire requise).
RESEND_API_KEY=
# Ignoré si RESEND_API_KEY est renseignée. Vide => fallback "console" provider (log
# l'e-mail au lieu de l'envoyer, utilisé automatiquement en dev/test).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Lumera
# Adresse recevant l'e-mail "Nouvelle commande reçue". Si vide, la notification est
# sautée (avec un log d'avertissement) sans jamais bloquer la commande.
OWNER_NOTIFICATION_EMAIL=

# === Cloudinary ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Rate limiting ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
